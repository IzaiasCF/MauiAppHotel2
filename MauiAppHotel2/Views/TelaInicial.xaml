<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiAppHotel2.Views.TelaInicial"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="TelaInicial"
    BackgroundColor="{StaticResource Gray900}"
    NavigationPage.HasNavigationBar="False">

    <VerticalStackLayout Padding="10" VerticalOptions="CenterAndExpand">

        <!--  Inserção da imagem hotel.png  -->
        <Image
            Aspect="AspectFit"
            HeightRequest="250"
            Source="hotel.png" />

        <Label
            Padding="25"
            FontFamily="Kalam"
            FontSize="25"
            HorizontalOptions="Center"
            Text="Hotel Campos do Jordão"
            TextColor="DarkOliveGreen" />

        <Label
            FontSize="15"
            HorizontalOptions="Center"
            Text="Descanse e aproveite sua estadia"
            TextColor="DarkOliveGreen"
            VerticalOptions="Center" />

        <Button
            Margin="10"
            BackgroundColor="DarkOliveGreen"
            Clicked="Button_Clicked"
            HorizontalOptions="Center"
            Text="Avançar"
            TextColor="Bisque" />

    </VerticalStackLayout>
</ContentPage>