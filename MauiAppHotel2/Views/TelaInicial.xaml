<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel2.Views.TelaInicial"
             BackgroundColor="{StaticResource Gray900}"
             NavigationPage.HasNavigationBar="False"
             Title="TelaInicial">
    
    <VerticalStackLayout Padding="10" VerticalOptions="CenterAndExpand">

        <!--  Inserção da imagem hotel.png  -->
        <Image
            Aspect="AspectFit"
            HeightRequest="250"
            Source="hotel.png" />

        <Label
            FontFamily="Kalam"
            FontSize="25"
            Padding="25"
            HorizontalOptions="Center"
            Text="Hotel Campos do Jordão"
            TextColor="DarkOliveGreen" />

        <Label Text="Descanse e aproveite sua estadia"
               FontSize="15" 
               TextColor="DarkOliveGreen"
               VerticalOptions="Center" 
                HorizontalOptions="Center" />

        <Button Text="Avançar"
                Margin="10"
                HorizontalOptions="Center"
                BackgroundColor="DarkOliveGreen"
                TextColor="Bisque"
                Clicked="Button_Clicked" />

    </VerticalStackLayout>
</ContentPage>