<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiAppHotel2.Views.ContratacaoHospedagem"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{StaticResource Gray900}"
    Title="Contratação da Hospedagem">

    <VerticalStackLayout 
        VerticalOptions="CenterAndExpand"
        Padding="10">

        <!--Inserção da imagem .png-->
        <Image
             Aspect="AspectFit"
             HeightRequest="150"
             Source="hotel.png" />

        <Label
            HorizontalOptions="Center"
            Text="Hotel Campos do Jordão"
            FontFamily="Kalam"
            FontSize="30"
            TextColor="DarkOliveGreen" />

        <Frame BackgroundColor="Black">

            <VerticalStackLayout>

                <Grid RowDefinitions="*, *"
                      ColumnDefinitions="*, *, *">
                    
                    <!--Grid dos adultos-->
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Adultos"
                           TextColor="DarkGreen"/>

                    <Label Grid.Row="0" Grid.Column="1"
                           TextColor="Green"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"
                           FontAttributes="Bold" />

                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"
                             Background="DarkOliveGreen"
                             BackgroundColor="DarkOliveGreen" />

                    <!--Grid das crianças-->
                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Crianças"
                           TextColor="DarkGreen"/>

                    <Label Grid.Row="1" Grid.Column="1"
                           TextColor="Green"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"
                           FontAttributes="Bold" />

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"
                             Background="DarkOliveGreen" 
                             BackgroundColor="DarkOliveGreen" />

                </Grid>

                <Label Text="Escolha sua Suite"
                       TextColor="DarkOliveGreen"
                       HorizontalOptions="Center"
                       Margin="10"
                       Padding="10" />

                <Picker x:Name="pck_quarto"
                        BackgroundColor="DarkOliveGreen" />

                <Frame Padding="10"
                       Margin="10">

                    <VerticalStackLayout>
                        <Label Text="Período da Estadia" />
                        
                        <HorizontalStackLayout>
                            <Label Text="Check-in" />
                            <DatePicker x:Name="dtpck_checking"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout>
                            <Label Text="Check-out"
                                   Margin="5"/>
                            <DatePicker x:Name="dtpck_checkout"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                    
                </Frame>

                <Button Text="Avançar"
                        BackgroundColor="DarkOliveGreen"
                        TextColor="Bisque"
                        Clicked="Button_Clicked" />

            </VerticalStackLayout>

        </Frame>

    </VerticalStackLayout>
</ContentPage>