<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiAppHotel2.Views.ContratacaoHospedagem"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Contratação da Hospedagem"
    BackgroundColor="{StaticResource Gray900}"
    NavigationPage.HasNavigationBar="False">

    <VerticalStackLayout 
        Padding="10"
        Spacing="10"
        VerticalOptions="CenterAndExpand">

        <!--  Inserção da imagem hotel.png  -->
        <Image
            Aspect="AspectFit"
            HeightRequest="120"
            Source="hotel.png" />

        <Label
            FontFamily="Kalam"
            FontSize="25"
            HorizontalOptions="Center"
            Text="Hotel Campos do Jordão"
            TextColor="DarkOliveGreen" />

        <Frame BackgroundColor="Black">

            <VerticalStackLayout>

                <Grid ColumnDefinitions="*, *, *" RowDefinitions="*, *">

                    <!--  Grid dos adultos  -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Adultos"
                        TextColor="DarkGreen" />

                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        BindingContext="{x:Reference stp_adultos}"
                        FontAttributes="Bold"
                        Text="{Binding Value}"
                        TextColor="Green" />

                    <Stepper
                        x:Name="stp_adultos"
                        Grid.Row="0"
                        Grid.Column="2"
                        Background="DarkOliveGreen"
                        BackgroundColor="DarkOliveGreen"
                        Increment="1"
                        Maximum="10"
                        Minimum="0" />

                    <!--  Grid das crianças  -->
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Crianças"
                        TextColor="DarkGreen" />

                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        BindingContext="{x:Reference stp_criancas}"
                        FontAttributes="Bold"
                        Text="{Binding Value}"
                        TextColor="Green" />

                    <Stepper
                        x:Name="stp_criancas"
                        Grid.Row="1"
                        Grid.Column="2"
                        Background="DarkOliveGreen"
                        BackgroundColor="DarkOliveGreen"
                        Increment="1"
                        Maximum="10"
                        Minimum="0" />

                </Grid>

        <Frame 
            Padding="10" 
            Margin="10"
            BackgroundColor="DarkOliveGreen">
                    
            <VerticalStackLayout>
                    
                    <Label
                    Margin="10"
                    Padding="10"
                    HorizontalOptions="Center"
                    Text="Escolha sua Suite"
                    TextTransform="Uppercase"
                    TextColor="NavajoWhite" />

                    <Picker
                    x:Name="pck_quarto"
                    Background="NavajoWhite"
                    ItemDisplayBinding="{Binding Descricao}" />

            </VerticalStackLayout>

        </Frame>

                <Frame Padding="10"
                       Margin="10"
                       BackgroundColor="DarkOliveGreen">

                    <VerticalStackLayout Spacing="10">

                        <Label
                            HorizontalTextAlignment="Center"
                            Text="Período da Estadia"
                            TextTransform="Uppercase"
                            TextColor="NavajoWhite" />

                        <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                            <Label 
                                Text="Check-in" 
                                TextColor="NavajoWhite" />

                            <DatePicker
                                x:Name="dtpck_checking"
                                DateSelected="dtpck_checking_DateSelected"
                                Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                            <Label
                                Margin="5"
                                Text="Check-out"
                                TextColor="NavajoWhite" />

                            <DatePicker x:Name="dtpck_checkout" Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Frame>

                <Button
                    BackgroundColor="DarkOliveGreen"
                    Clicked="Button_Clicked"
                    Text="Avançar"
                    HorizontalOptions="Center"
                    TextColor="NavajoWhite" />

            </VerticalStackLayout>

        </Frame>

    </VerticalStackLayout>
</ContentPage>