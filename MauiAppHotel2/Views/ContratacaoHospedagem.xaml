<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiAppHotel2.Views.ContratacaoHospedagem"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{StaticResource Gray900}"
    Title="ContratacaoHospedagem">

    <VerticalStackLayout 
        VerticalOptions="CenterAndExpand"
        Padding="10">

        <!--Inserção da imagem .png-->
        <Image
             Aspect="AspectFit"
             HeightRequest="150"
             Source="hotel.png" />

        <Label
            HorizontalOptions="Center"
            Text="Hotel Campos do Jordão"
            FontFamily="Kalam"
            FontSize="30"
            TextColor="DarkOliveGreen" />

        <Frame>

            <VerticalStackLayout>

                <Grid RowDefinitions="auto, auto"
                      ColumnDefinitions="*, *, 2">
                    
                    <!--Grid dos adultos-->
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Adultos"
                           TextColor="DarkGreen"/>

                    <Label Grid.Row="0" Grid.Column="1"
                           TextColor="Green"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"
                           FontAttributes="Bold" />

                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1" />

                    <!--Grid das crianças-->
                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Crianças"
                           TextColor="DarkGreen"/>

                    <Label Grid.Row="1" Grid.Column="1"
                           TextColor="Green"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"
                           FontAttributes="Bold" />

                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1" />

                </Grid>

            </VerticalStackLayout>

        </Frame>

    </VerticalStackLayout>
</ContentPage>